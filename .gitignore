# Zelda 64 Player .gitignore
# Adapted from Ludere + project-specific additions

# Gradle / Build
*.iml
.gradle/
.gradle
/local.properties
/.idea
/app/release
**/build/
/.externalNativeBuild
/.cxx
**/.cxx/
.cxx/
.kotlin/
*.apk
*.aab
*.ap_

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/

# ROMs / Patches / Catalog (NEVER COMMIT)
# Base ROMs imported by user
/app/src/main/assets/base_roms/
/app/src/main/res/raw/rom
*.z64
*.n64
*.v64
*.rom
*.bps
*.ips
*.ups
catalog.json
# The shipped default catalog is tracked; user caches are not.
!catalog/catalog.json

# Cache directories (runtime)
/app/.cxx/
/libretrodroid/.cxx/
*.so

# Keystore (release signing)
*.jks
*.keystore
ludere.jks
keystore.properties

# Test fixtures (synthetic only - no real ROMs)
/app/src/test/fixtures/roms/*.z64
/app/src/test/fixtures/roms/*.n64
/app/src/test/fixtures/roms/*.v64
/app/src/test/fixtures/patches/*.bps

# Documentation research cache
.puffy-research/
.calamari-cache/

# Cover images (generated by Dolfi, not committed)
/app/src/main/assets/covers/

# Kotlin / KSP / KAPT
**/build/generated/ksp/
**/build/generated/kapt/

# Profiling / Captures
/captures/
*.hprof
*.trace
