<?xml version="1.0" encoding="utf-8"?>
<!-- Flat Switch-style search field background: panel fill with a subtle 1dp
     secondary-color stroke. Used by the "Todos os Jogos" filter bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/switch_panel" />
    <stroke
        android:width="1dp"
        android:color="@color/switch_text_secondary" />
    <corners android:radius="4dp" />
</shape>
