<?xml version="1.0" encoding="utf-8"?>
<!-- Flat settings section with the thin separators used by Switch system menus. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_bg" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_text_secondary" />
        </shape>
    </item>
</layer-list>
