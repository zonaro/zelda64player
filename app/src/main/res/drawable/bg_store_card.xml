<?xml version="1.0" encoding="utf-8"?>
<!-- Switch-style store grid card: flat panel surface with a cyan focus border
     (mirrors the Switch focus system used by the home-row cards). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_enabled="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/switch_panel" />
                    <corners android:radius="@dimen/card_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/switch_focus_border_width"
                        android:color="@color/switch_accent" />
                    <corners android:radius="@dimen/card_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_panel" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
