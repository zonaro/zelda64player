<?xml version="1.0" encoding="utf-8"?>
<!-- Flat Switch-style text field background: page-fill inset with a subtle
     secondary-color stroke (replaces the expressive pill input). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/switch_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/switch_text_secondary" />
    <corners android:radius="4dp" />
</shape>
