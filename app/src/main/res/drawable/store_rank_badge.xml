<?xml version="1.0" encoding="utf-8"?>
<!-- Ranking number badge on a store grid card (top-left of the cover). Uses the
     Switch panel token as the chip background so it flips with the theme, and the
     accent token for the number text (set on the TextView). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/switch_panel" />
    <corners android:radius="4dp" />
</shape>
