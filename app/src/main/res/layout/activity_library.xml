<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Big header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/header_padding"
            android:paddingTop="@dimen/header_padding"
            android:paddingEnd="@dimen/header_padding"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_name"
                android:textColor="@color/color_primary"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/library_subtitle"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/library_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp"
                android:scrollbars="vertical" />

            <!-- Empty state: icon + text, toggled as a unit -->
            <LinearLayout
                android:id="@+id/library_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/library_empty"
                    android:src="@drawable/ic_launcher_foreground"
                    android:tint="@color/color_surface_variant"
                    app:tint="@color/color_surface_variant" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/library_empty"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/library_settings"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/library_settings_description"
        android:scaleType="center"
        android:src="@drawable/ic_settings"
        android:tint="@color/color_on_surface"
        app:tint="@color/color_on_surface" />

    <ImageButton
        android:id="@+id/library_store"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/library_menu_store"
        android:scaleType="center"
        android:src="@drawable/ic_store"
        android:tint="@color/color_on_surface"
        app:tint="@color/color_on_surface" />

    <ImageButton
        android:id="@+id/library_randomizer"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="112dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/library_menu_randomizer"
        android:scaleType="center"
        android:src="@drawable/ic_randomizer"
        android:tint="@color/color_on_surface"
        app:tint="@color/color_on_surface" />

</FrameLayout>
