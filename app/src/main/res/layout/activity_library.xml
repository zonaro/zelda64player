<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switch_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Keeps the profile entry point and the selected-game title separate,
             mirroring the compact account/status area above the HOME row. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="60dp" />

        <br.com.redclaw.zelda64player.ui.switchui.SwitchHomeRow
            android:id="@+id/library_home_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Flexible middle pushes the dock + footer to the bottom. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <br.com.redclaw.zelda64player.ui.switchui.SwitchDock
            android:id="@+id/library_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- The thin HOME-menu divider visually separates launcher actions
             from controller/status and options hints. -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/switch_screen_margin"
            android:layout_marginEnd="@dimen/switch_screen_margin"
            android:alpha="0.55"
            android:background="@color/switch_text_secondary" />

        <br.com.redclaw.zelda64player.ui.switchui.SwitchFooterHints
            android:id="@+id/library_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />
    </LinearLayout>

    <!-- The player's RetroAchievements avatar stays reachable independently of
         the game row, mirroring the account entry point in a console home UI. -->
    <ImageButton
        android:id="@+id/library_ra_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_ra_avatar"
        android:contentDescription="@string/ra_profile_avatar_description"
        android:focusable="true"
        android:padding="3dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_trophy" />

    <!-- Empty state, toggled as a unit when no games are installed. -->
    <LinearLayout
        android:id="@+id/library_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/library_empty"
            android:src="@drawable/ic_launcher_foreground"
            android:tint="@color/switch_text_secondary"
            app:tint="@color/switch_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/library_empty"
            android:textColor="@color/switch_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
