<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switch_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Flexible top space: together with the middle spacer it vertically
             centers the game row block between screen top and dock. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <br.com.redclaw.zelda64player.ui.switchui.SwitchHomeRow
            android:id="@+id/library_home_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Flexible middle pushes the dock + footer to the bottom. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <br.com.redclaw.zelda64player.ui.switchui.SwitchDock
            android:id="@+id/library_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/switch_screen_margin" />

        <br.com.redclaw.zelda64player.ui.switchui.SwitchFooterHints
            android:id="@+id/library_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp" />
    </LinearLayout>

    <!-- Empty state, toggled as a unit when no games are installed. -->
    <LinearLayout
        android:id="@+id/library_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/library_empty"
            android:src="@drawable/ic_launcher_foreground"
            android:tint="@color/switch_text_secondary"
            app:tint="@color/switch_text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/library_empty"
            android:textColor="@color/switch_text_secondary"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
