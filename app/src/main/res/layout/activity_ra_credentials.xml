<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switch_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/ra_credentials_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/switch_panel"
        android:elevation="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_ra_credentials_desc"
                android:textColor="@color/switch_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settings_ra_enabled_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/switch_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/settings_ra_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/shape_field"
                android:hint="@string/settings_ra_username_hint"
                android:inputType="text"
                android:paddingStart="@dimen/input_horizontal_padding"
                android:paddingTop="@dimen/input_vertical_padding"
                android:paddingEnd="@dimen/input_horizontal_padding"
                android:paddingBottom="@dimen/input_vertical_padding"
                android:textColor="@color/switch_text_primary"
                android:textColorHint="@color/switch_text_secondary" />

            <EditText
                android:id="@+id/settings_ra_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_field"
                android:hint="@string/settings_ra_password_hint"
                android:inputType="textPassword"
                android:paddingStart="@dimen/input_horizontal_padding"
                android:paddingTop="@dimen/input_vertical_padding"
                android:paddingEnd="@dimen/input_horizontal_padding"
                android:paddingBottom="@dimen/input_vertical_padding"
                android:textColor="@color/switch_text_primary"
                android:textColorHint="@color/switch_text_secondary" />

            <EditText
                android:id="@+id/settings_ra_api_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_field"
                android:hint="@string/settings_ra_api_key_hint"
                android:inputType="textPassword"
                android:paddingStart="@dimen/input_horizontal_padding"
                android:paddingTop="@dimen/input_vertical_padding"
                android:paddingEnd="@dimen/input_horizontal_padding"
                android:paddingBottom="@dimen/input_vertical_padding"
                android:textColor="@color/switch_text_primary"
                android:textColorHint="@color/switch_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_ra_api_key_help"
                android:textColor="@color/switch_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settings_ra_login"
                    style="@style/SwitchButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_ra_login" />

                <Button
                    android:id="@+id/settings_ra_logout"
                    style="@style/SwitchButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/settings_ra_logout" />
            </LinearLayout>

            <Button
                android:id="@+id/settings_ra_save_api_key"
                style="@style/SwitchButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_ra_save_api_key" />

            <TextView
                android:id="@+id/settings_ra_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/switch_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
