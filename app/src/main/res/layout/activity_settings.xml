<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen restyled to the Nintendo Switch UI: a fixed category
     sidebar in landscape, a hamburger drawer in portrait, flat rows, and
     theme-token colors rather than Material expressive cards or pills. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switch_bg">

    <LinearLayout
        android:id="@+id/settings_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/switch_panel"
        app:navigationIconTint="@color/switch_text_primary"
        app:titleTextColor="@color/switch_text_primary" />

        <LinearLayout
            android:id="@+id/settings_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Fixed category navigation in landscape. SettingsActivity turns this
                 into a conventional hamburger drawer in portrait. -->
            <LinearLayout
                android:id="@+id/settings_navigation"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.34"
                android:background="@color/switch_panel"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:text="@string/settings_navigation_title"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/settings_nav_import"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/settings_import_title" />

                <TextView
                    android:id="@+id/settings_nav_baseroms"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/settings_baseroms_title" />

                <TextView
                    android:id="@+id/settings_nav_catalog"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/settings_catalog_title" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:alpha="0.35"
                    android:background="@color/switch_text_secondary" />

                <TextView
                    android:id="@+id/settings_nav_ra"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/settings_ra_title" />

                <TextView
                    android:id="@+id/settings_nav_core"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/settings_core_title" />

                <TextView
                    android:id="@+id/settings_nav_backup"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/backup_title" />

                <TextView
                    android:id="@+id/settings_nav_language"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/settings_language_title" />

                <TextView
                    android:id="@+id/settings_nav_about"
                    style="@style/SwitchSettingsNavigationRow"
                    android:text="@string/settings_about_title" />
            </LinearLayout>

            <View
                android:id="@+id/settings_navigation_divider"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:alpha="0.4"
                android:background="@color/switch_text_secondary" />

            <ScrollView
                android:id="@+id/settings_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.66"
                android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Section A: import base ROM -->
            <LinearLayout
                android:id="@+id/settings_section_import"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_import_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_import_description"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settings_import_button"
                    style="@style/SwitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_import_button" />

                <ProgressBar
                    android:id="@+id/settings_import_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Section B: imported base ROMs -->
            <LinearLayout
                android:id="@+id/settings_section_baseroms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_baseroms_title" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/settings_baserom_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/settings_baserom_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_baseroms_empty"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section C: custom catalog URLs -->
            <LinearLayout
                android:id="@+id/settings_section_catalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_catalog_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_catalog_description"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/settings_catalog_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/shape_field"
                        android:hint="@string/settings_catalog_hint"
                        android:inputType="textUri"
                        android:paddingStart="@dimen/input_horizontal_padding"
                        android:paddingTop="@dimen/input_vertical_padding"
                        android:paddingEnd="@dimen/input_horizontal_padding"
                        android:paddingBottom="@dimen/input_vertical_padding"
                        android:textColor="@color/switch_text_primary"
                        android:textColorHint="@color/switch_text_secondary" />

                    <Button
                        android:id="@+id/settings_catalog_add"
                        style="@style/SwitchButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_catalog_add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/settings_catalog_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_error"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/settings_catalog_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <TextView
                    android:id="@+id/settings_catalog_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_catalog_empty"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section C3: RetroAchievements -->
            <LinearLayout
                android:id="@+id/settings_section_ra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_ra_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/settings_ra_description"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_ra_enabled"
                        android:textColor="@color/switch_text_primary"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/settings_ra_enabled_switch"
                        style="@style/SwitchSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <EditText
                    android:id="@+id/settings_ra_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_field"
                    android:hint="@string/settings_ra_username_hint"
                    android:inputType="text"
                    android:paddingStart="@dimen/input_horizontal_padding"
                    android:paddingTop="@dimen/input_vertical_padding"
                    android:paddingEnd="@dimen/input_horizontal_padding"
                    android:paddingBottom="@dimen/input_vertical_padding"
                    android:textColor="@color/switch_text_primary"
                    android:textColorHint="@color/switch_text_secondary" />

                <EditText
                    android:id="@+id/settings_ra_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_field"
                    android:hint="@string/settings_ra_password_hint"
                    android:inputType="textPassword"
                    android:paddingStart="@dimen/input_horizontal_padding"
                    android:paddingTop="@dimen/input_vertical_padding"
                    android:paddingEnd="@dimen/input_horizontal_padding"
                    android:paddingBottom="@dimen/input_vertical_padding"
                    android:textColor="@color/switch_text_primary"
                    android:textColorHint="@color/switch_text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/settings_ra_login"
                        style="@style/SwitchButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_ra_login" />

                    <Button
                        android:id="@+id/settings_ra_logout"
                        style="@style/SwitchButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/settings_ra_logout" />
                </LinearLayout>

                <TextView
                    android:id="@+id/settings_ra_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Section D: emulator core -->
            <LinearLayout
                android:id="@+id/settings_section_core"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_core_title" />

                <TextView
                    android:id="@+id/settings_core_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settings_core_button"
                    style="@style/SwitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_core_change" />
            </LinearLayout>

            <!-- Section Backups -->
            <LinearLayout
                android:id="@+id/settings_section_backup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/backup_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/backup_description"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settings_backup_export"
                    style="@style/SwitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/backup_export" />

                <Button
                    android:id="@+id/settings_backup_import"
                    style="@style/SwitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/backup_import" />

                <ProgressBar
                    android:id="@+id/settings_backup_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Section: Language -->
            <LinearLayout
                android:id="@+id/settings_section_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_title" />

                <TextView
                    android:id="@+id/settings_language_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settings_language_button"
                    style="@style/SwitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/language_select" />
            </LinearLayout>

            <!-- Section Sobre -->
            <LinearLayout
                android:id="@+id/settings_section_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_settings_section"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SwitchSectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_about_title" />

                <TextView
                    android:id="@+id/settings_about_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/settings_about_repo"
                    style="@style/SwitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_about_repo" />

                <Button
                    android:id="@+id/settings_about_catalog"
                    style="@style/SwitchButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings_about_catalog" />

                <TextView
                    android:id="@+id/settings_about_licenses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/settings_about_licenses"
                    android:textColor="@color/switch_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
