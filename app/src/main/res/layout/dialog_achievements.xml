<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/achievements_scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/switch_scrim">

    <LinearLayout
        android:id="@+id/achievements_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_switch_dialog"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: icon + title + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_trophy"
                android:tint="@color/switch_accent" />

            <TextView
                android:id="@+id/dialog_achievements_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/achievements_title"
                android:textColor="@color/switch_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/dialog_achievements_close"
                style="@style/SwitchButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@android:string/ok" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:alpha="0.3"
            android:background="@color/switch_text_secondary" />

        <!-- Per-game header card (visible only in single-game mode) -->
        <LinearLayout
            android:id="@+id/dialog_achievements_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_card"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/dialog_achievements_game_badge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialog_achievements_game_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialog_achievements_progress_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Search + sort bar (Switch-style flat field) -->
        <LinearLayout
            android:id="@+id/dialog_achievements_search_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/dialog_achievements_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawableTint="@color/switch_text_secondary"
                android:hint="@string/ra_search_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:singleLine="true"
                android:textColor="@color/switch_text_primary"
                android:textColorHint="@color/switch_text_secondary"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/dialog_achievements_sort"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/ra_sort_button"
                android:src="@drawable/ic_tune"
                android:tint="@color/switch_accent" />

            <ImageButton
                android:id="@+id/dialog_achievements_view_toggle"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/ra_view_mode"
                android:src="@drawable/ic_view_list"
                android:tint="@color/switch_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/dialog_achievements_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dialog_achievements_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>
</FrameLayout>
