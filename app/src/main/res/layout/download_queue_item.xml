<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/switch_panel"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/item_cover"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/shape_cover"
        android:clipToOutline="true"
        android:contentDescription="@string/cover_content_description"
        android:scaleType="fitCenter"
        tools:src="@drawable/placeholder_cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/switch_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Ocarina of Time DX" />

        <TextView
            android:id="@+id/item_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/switch_text_secondary"
            android:textSize="13sp"
            tools:text="Baixando… 42%" />

        <ProgressBar
            android:id="@+id/item_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone"
            tools:progress="42"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/item_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_error"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Erro de rede."
            tools:visibility="visible" />
    </LinearLayout>

    <Button
        android:id="@+id/item_action"
        style="@style/SwitchButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"
        android:minWidth="96dp"
        android:text="@string/download_cancel"
        tools:ignore="ButtonStyle" />
</LinearLayout>
