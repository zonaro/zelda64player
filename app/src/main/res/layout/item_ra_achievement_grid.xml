<?xml version="1.0" encoding="utf-8"?>
<br.com.redclaw.zelda64player.retroachievements.ui.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_ra_grid_cell"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/ra_grid_badge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/ra_grid_unlocked"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_dock_circle"
        android:importantForAccessibility="no"
        android:padding="3dp"
        android:src="@drawable/ic_check"
        android:tint="@color/color_primary"
        android:visibility="gone" />
</br.com.redclaw.zelda64player.retroachievements.ui.SquareFrameLayout>