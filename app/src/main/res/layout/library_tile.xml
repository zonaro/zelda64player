<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Covers are bundled at their native 10:7 landscape ratio, so
         adjustViewBounds derives the height from the measured width and the
         item is exactly as tall as its thumbnail. -->
    <ImageView
        android:id="@+id/tile_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:background="#202020" />

    <!-- Title overlays the bottom of the cover so the whole item is just the
         thumbnail; a gradient scrim keeps it legible over any artwork. -->
    <TextView
        android:id="@+id/tile_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/tile_title_scrim"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="18dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

</FrameLayout>
