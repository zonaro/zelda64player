<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menu_item"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_item"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/menu_cell_min_height"
    android:padding="@dimen/menu_cell_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/menu_item_icon"
            android:layout_width="@dimen/menu_icon_size"
            android:layout_height="@dimen/menu_icon_size"
            android:layout_marginBottom="@dimen/menu_icon_margin_bottom"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/menu_item_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/menu_label_text_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/menu_item_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/menu_badge_margin"
        android:background="@drawable/bg_menu_badge"
        android:clickable="false"
        android:focusable="false"
        android:paddingStart="@dimen/menu_badge_padding_horizontal"
        android:paddingEnd="@dimen/menu_badge_padding_horizontal"
        android:paddingTop="@dimen/menu_badge_padding_vertical"
        android:paddingBottom="@dimen/menu_badge_padding_vertical"
        android:textColor="@color/color_on_primary_container"
        android:textSize="@dimen/menu_badge_text_size"
        android:visibility="gone" />
</FrameLayout>
