<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zelda64Player" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Window -->
        <item name="android:windowBackground">@color/color_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Material 3 color tokens -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_on_error</item>
        <item name="android:colorBackground">@color/color_background</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/color_on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/color_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/color_surface_container_high</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>

        <!-- Pill buttons everywhere (fully rounded) -->
        <item name="materialButtonStyle">@style/Widget.Zelda.PillButton</item>

        <!-- Bottom-sheet dialog (hack detail) -->
        <item name="bottomSheetDialogTheme">@style/Theme.Zelda64Player.BottomSheet</item>
    </style>

    <!-- Fully rounded pill button -->
    <style name="Widget.Zelda.PillButton" parent="Widget.Material3.Button">
        <item name="android:paddingStart">@dimen/pill_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/pill_horizontal_padding</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="cornerRadius">999dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Bottom-sheet: transparent container so the sheet's own rounded
         surfaceContainerHigh background (drawn by the fragment) shows. -->
    <style name="Theme.Zelda64Player.BottomSheet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/StoreBottomSheetAnimation</item>
        <item name="bottomSheetStyle">@style/Widget.Zelda.BottomSheet</item>
    </style>

    <style name="Widget.Zelda.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Bottom-sheet style for the hack detail dialog: anchored to the bottom,
         full width, with a slide-up/down animation. -->
    <style name="StoreBottomSheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/StoreBottomSheetAnimation</item>
    </style>

    <style name="StoreBottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>

    <!-- Section header used inside the Plandomizer visual builder. -->
    <style name="PlandomizerSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
